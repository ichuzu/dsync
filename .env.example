# Supabase configuration — copy this file to `.env` and fill in your values.
# The publishable (anon) key is safe to expose in the client; data access is
# protected by row-level security.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Steam Web API key — SERVER-SIDE ONLY. Used by the dev API (vite-plugin-steam)
# to fetch your profile, library, and achievements. Get one at
# https://steamcommunity.com/dev/apikey. Do NOT add a VITE_ prefix, or it would
# be bundled into the browser. Restart `npm run dev` after setting it.
STEAM_API_KEY=""

# Optional: in production the browser can't reach the dev API, so point it at a
# deployed Steam proxy (e.g. the Supabase edge function). Defaults to /api/steam.
# VITE_STEAM_API_BASE="https://your-project.functions.supabase.co/steam-auth"
